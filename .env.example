# Скопируйте в .env и заполните. Файл .env в git не попадает.

# API статистики грейдера
API_URL=https://api.example.test/statistics/
API_CLIENT=
API_CLIENT_KEY=

# Локальный PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DB=itogovyj_etl
PG_USER=
PG_PASSWORD=

# Google Sheets (необязательно): ключ сервисного аккаунта и ID таблицы
SHEETS_KEY_PATH=service_account.json
SHEETS_SPREADSHEET_ID=

# Почта (необязательно): Gmail, пароль приложения без пробелов
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Кому слать уведомления; если пусто, пишем на SMTP_USER
NOTIFY_TO=
